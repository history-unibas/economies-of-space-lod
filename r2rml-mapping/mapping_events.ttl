@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix eos: <https://eos.lod4hss.org/ontology#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sdh-short: <https://sdhss.org/ontology/shortcuts/>.
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/>.
@prefix rico: <https://www.ica.org/standards/RiC/ontology#>.
@prefix sdh-slc: <https://sdhss.org/ontology/social-life-core/>.
@prefix sdh-info: <https://sdhss.org/ontology/sources-information-metadata/>.

<#t_event_group_with_properties_1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "t_event_group_with_properties" ];
    rr:subjectMap [
        rr:template "https://ld.bs.ch/hgb/resource/evg_{pk_t_event_group}";
        rr:termType rr:IRI;
        ## Propositional Object
        rr:class sdh-info:C23;
    ];
    rr:predicateObjectMap [
        ## referring to things of type
        rr:predicate eos:hasYear;
        rr:objectMap [ rr:column "year" ];
    ];
    rr:predicateObjectMap [
        ## referring to things of type
        rr:predicate eos:hasType;
        rr:object "event_group";
    ];
    rr:predicateObjectMap [
        ## referring to things of type
        rr:predicate eos:hasEventGroupType;
        rr:objectMap [ rr:column "ev_gr_type" ];
        ];
    rr:predicateObjectMap [
        ## referring to things of type
        rr:predicate eos:hasEventGroupClass;
        rr:objectMap [ rr:template "https://ld.bs.ch/hgb/resource/evgrcl_{fk_event_group_class}" ];
    ];
    rr:predicateObjectMap [
        ## has chunk type
        rr:predicate eos:hasEventGroupClassLabel;
        rr:objectMap [ rr:column "ev_gr_class" ];
    ];
    rr:predicateObjectMap [
        ## referring to things of type
        rr:predicate eos:hasEventGroupTriggerChunk;
        rr:objectMap [ rr:template "https://ld.bs.ch/hgb/resource/i{entryid}_span{ev_gr_trigger_ref}" ];
    ];
    rr:predicateObjectMap [
        rr:predicate eos:hasEventGroupTriggerText;
        rr:objectMap [ rr:column "ev_gr_trigger_text" ];
    ].






<#t_event_group_class_1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "t_event_group_class" ];
    rr:subjectMap [
        rr:template "https://ld.bs.ch/hgb/resource/evgrcl_{pk_event_group_class}";
        rr:termType rr:IRI;
        ## Propositional Object
        rr:class eos:factoidClass;
    ];
    rr:predicateObjectMap [
        ## referring to things of type
        rr:predicate eos:hasLabel;
        rr:objectMap [ rr:column "ev_gr_class" ];
    ]
    .







<#t_event_with_id_1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "t_event_with_id" ];
    rr:subjectMap [
        rr:template "https://ld.bs.ch/hgb/resource/ev_{event_uri}";
        rr:termType rr:IRI;
        ## Propositional Object
        rr:class sdh-info:C23;
    ];
    rr:predicateObjectMap [
        ## referring to things of type
        rr:predicate eos:hasType;
        rr:object "event";
    ];
    rr:predicateObjectMap [
        ## referring to things of type
        rr:predicate eos:isPartOfEventGroup;
        rr:objectMap [ rr:template "https://ld.bs.ch/hgb/resource/evg_{fk_event_group}" ];
    ]
    .



<#t_role_1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "t_role" ];
    rr:subjectMap [
        rr:template "https://ld.bs.ch/hgb/resource/evr_{role_uri}";
        rr:termType rr:IRI;
        ## Propositional Object
        rr:class eos:eventRole;
    ];
    rr:predicateObjectMap [
        ## referring to things of type
        rr:predicate eos:hasRole;
        rr:objectMap [ rr:column "role_role" ];
    ];
    rr:predicateObjectMap [
        ## referring to things of type
        rr:predicate eos:hasRoleText;
        rr:objectMap [ rr:column "role_text" ];
    ];
    rr:predicateObjectMap [
        ## referring to things of type
        rr:predicate eos:isPartOfEvent;
        rr:objectMap [ rr:template "https://ld.bs.ch/hgb/resource/ev_{event_uri}" ];
    ];
    rr:predicateObjectMap [
        ## referring to things of type
        rr:predicate eos:refersToChunk;
        rr:objectMap [ rr:template "https://ld.bs.ch/hgb/resource/i{fk_span_uri}" ];
    ]
    .
