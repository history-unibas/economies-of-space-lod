                <mxCell id="28" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;I&#39;m not sure what should be the Link here:&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;rico:isCopyOf ?&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="600" y="750" width="150" height="49" as="geometry"/>
                </mxCell>
                <mxCell id="29" value="&lt;b&gt;Il s&#39;agit ici de l&#39;équivalent à Geographical Place. Comme on en a discuté, il d&#39;agit de la localisation de l&#39;objet mentionné dans l&#39;XML&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="905" y="910" width="185" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="30" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;Je ne suis pas sûr si l&#39;équivalence est avec le Stabs-serie/dossier ou project serie/dossier&lt;/font&gt;&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="360" y="140" width="185" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="31" value="&lt;b&gt;Il s&#39;agit ici de la relation de continuité entre les différents dossiers: de source (ancien) à target (nouveau)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="819" y="200" width="185" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="32" value="&lt;b&gt;Il s&#39;agit ici du document archivistique physique, la feuille cartonnée&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="630" y="430" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="33" value="&lt;b&gt;Cette relation documente le fait que l&#39;adresse se trouve au sein d&#39;une rue&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
